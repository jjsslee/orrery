# Copy to .env (gitignored). The server reads it at start; existing environment variables win.
# Profile to open with when the browser has no saved choice (falls back to AWS_PROFILE, then "default").
ORRERY_DEFAULT_PROFILE=my-dev-profile
# API port (not PORT: dev launchers set PORT for the web app)
# ORRERY_PORT=4820
# Cache lifetimes
# ORRERY_GRAPH_TTL_MS=600000
# ORRERY_METRICS_TTL_MS=60000
